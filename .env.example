PORT=3000
ALERT_WEBHOOK_URL=
MONITOR_INTERVAL_MINUTES=30

# Direct browser connector controls
PLAYWRIGHT_HEADLESS=false
DIRECT_CONNECTORS_ENABLED=true

# IMPORTANT: only set these for providers for which you have permission/authorization
# to automate access. Restricted providers remain disabled regardless.
AUTHORIZED_DIRECT_PROVIDERS=

# Optional: path to a persistent Playwright browser profile on your machine.
# This can retain normal browser cookies/session state. Never store/share passwords in .env.
PLAYWRIGHT_PROFILE_DIR=./data/browser-profile
