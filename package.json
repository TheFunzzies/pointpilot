{
  "name": "pointpilot",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "PointPilot Windows 11 rewards optimizer with manual capture, historical award pricing, portfolio-aware optimization, and GitHub auto-updates.",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "monitor": "node --env-file-if-exists=.env monitor.mjs",
    "capture": "node scraper/manual-capture.mjs",
    "test": "node --test",
    "seed-history": "node historical/seed-history.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "configure-github": "node scripts/configure-github.mjs",
    "release": "electron-builder --win nsis --publish always",
    "release:check": "node scripts/check-release.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.pointpilot.desktop",
    "productName": "PointPilot",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist{,/**}",
      "!README-DIRECT-SCRAPING.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PointPilot-Setup-${version}.exe",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PointPilot"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
