{
  "name": "pointpilot",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "description": "PointPilot: find award space and fund trips from your points portfolio.",
  "main": "desktop/main.cjs",
  "workspaces": [
    "vendor/sign-in-with-chatgpt-devkit/packages/local"
  ],
  "scripts": {
    "start": "node server.mjs",
    "mcp": "node mcp/server.mjs",
    "monitor": "node server.mjs --monitor-once",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "eslint .",
    "desktop": "electron .",
    "build:siwc": "npm run build --workspace @siwc/local",
    "dist": "npm run build:siwc && electron-builder --win nsis --publish never",
    "release:check": "node scripts/check-release.mjs",
    "build:geo": "node scripts/build-geo.mjs",
    "build:hotel-awards": "node scripts/build-hotel-awards.mjs",
    "check:transfers": "node scripts/check-transfers.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@siwc/local": "file:vendor/sign-in-with-chatgpt-devkit/packages/local",
    "electron-updater": "6.8.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.19.2",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheFunzzies/pointpilot.git"
  },
  "homepage": "https://github.com/TheFunzzies/pointpilot",
  "build": {
    "appId": "com.pointpilot.desktop",
    "productName": "PointPilot",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "server.mjs",
      "lib/**",
      "mcp/**",
      "public/**",
      "reference/**",
      "desktop/**",
      "vendor/sign-in-with-chatgpt-devkit/packages/local/dist/**",
      "vendor/sign-in-with-chatgpt-devkit/packages/local/package.json",
      "vendor/sign-in-with-chatgpt-devkit/LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PointPilot-Setup-${version}.exe",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PointPilot",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TheFunzzies",
        "repo": "pointpilot",
        "releaseType": "release"
      }
    ]
  }
}
