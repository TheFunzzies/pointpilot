{
  "name": "pointpilot",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "PointPilot: find award space and fund trips from your points portfolio.",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "monitor": "node server.mjs --monitor-once",
    "test": "node --test",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release:check": "node scripts/check-release.mjs",
    "build:geo": "node scripts/build-geo.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheFunzzies/pointpilot.git"
  },
  "homepage": "https://github.com/TheFunzzies/pointpilot",
  "build": {
    "appId": "com.pointpilot.desktop",
    "productName": "PointPilot",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "server.mjs",
      "lib/**",
      "public/**",
      "reference/**",
      "desktop/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PointPilot-Setup-${version}.exe",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PointPilot",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TheFunzzies",
        "repo": "pointpilot",
        "releaseType": "release"
      }
    ]
  }
}
